NODE_ENV=production
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/timetable
JWT_SECRET=replace_with_a_random_64_character_secret
DEFAULT_ADMIN_PASSWORD=replace_with_a_strong_initial_password
CLIENT_URL=https://your-frontend.vercel.app
CORS_ORIGINS=https://your-frontend.vercel.app
PUBLIC_APP_URL=https://your-frontend.vercel.app
TRUST_PROXY=true
JSON_BODY_LIMIT=2mb
SCHEDULER_GENERATION_RUNS=8
SCHEDULER_GENERATION_TIME_LIMIT_MS=30000
SCHEDULER_GENERATION_ATTEMPTS=500
